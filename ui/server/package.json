{
  "name": "@beacon/server",
  "private": true,
  "description": "Beacon UI backend: enqueues jobs and streams progress (api) or runs bcn for queued jobs (worker).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": { "beacon-ui": "./bin/beacon-ui" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/cli.ts",
    "test": "vitest run",
    "record": "RECORD=1 vitest run test/contract.test.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.5",
    "fastify": "5.12.5",
    "ioredis": "5.11.1",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@beacon/shared": "*",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "vitest": "5.0.2"
  }
}
